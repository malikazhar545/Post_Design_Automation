{
  "manifest_version": 3,
  "name": "Post Automation - __NAME__",
  "version": "3.6",
  "description": "Post design automation helper (__NAME__ profile)",
  "permissions": ["tabs", "scripting", "storage", "downloads", "alarms", "notifications", "tabGroups", "contentSettings"],
  "icons": { "128": "icon.png" },
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Post Automation - __NAME__", "default_popup": "popup.html" }
}

{
  "manifest_version": 3,
  "name": "Post Automation - ENVATO",
  "version": "4.0",
  "description": "Post design automation helper (ENVATO profile)",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "downloads",
    "alarms",
    "notifications",
    "tabGroups",
    "contentSettings"
  ],
  "icons": {
    "128": "icon.png"
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Post Automation - ENVATO",
    "default_popup": "popup.html"
  }
}
